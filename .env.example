# انسخ هذا الملف باسم .env وعبّي القيم. لا ترفع .env على GitHub أبداً.

# كلمة سر اللوحة (إلزامي على أي سيرفر خارجي)
DASHBOARD_PASSWORD=

# وكيل الأخبار: مفتاح xAI من console.x.ai
XAI_API_KEY=

# وكلاء القرار (Qwen و DeepSeek): مفتاح من openrouter.ai
OPENROUTER_API_KEY=

# كلمة سر الإشارات من TradingView (اختر أي نص طويل عشوائي)
WEBHOOK_SECRET=

# الموديلات (غيّرها إذا نزلت نسخ أحدث)
NEWS_MODEL=x-ai/grok-4.7
QWEN_MODEL=qwen/qwen3.8-max-prime
DEEPSEEK_MODEL=~deepseek/deepseek-pro-latest
# خبراء الاجتماع (رخيص) ورئيس الاجتماع
MEMBER_MODEL=~deepseek/deepseek-flash-latest
CHAIR_MODEL=qwen/qwen3.8-max-prime

# وضع التجربة: أسعار وقرارات وهمية بدون مفاتيح (1 = تشغيل)
DEMO=0

# المنطقة الزمنية لحساب "اليوم"
TZ=Asia/Kuwait
PORT=3000
